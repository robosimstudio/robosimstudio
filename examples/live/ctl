#!/usr/bin/env bash
# The command line onto the live page, with run/ pinned beside scene.py: the checkout's .venv, else $PYTHON or python3.
# `up` also starts the page on the scene.py beside this script unless --scene names another file, so
# `examples/live/ctl up` from the repository root works as `./ctl up` does from here.
here="$(dirname "$0")"; py="$here/../../.venv/bin/python"; [ -x "$py" ] || py="${PYTHON:-python3}"
argv=("$@"); i=0
while [ "$i" -lt "${#argv[@]}" ]; do
  case "${argv[$i]}" in
    --run-dir|--sock) i=$((i + 2)) ;;
    -*) i=$((i + 1)) ;;
    *) break ;;
  esac
done
if [ "${argv[$i]:-}" = up ]; then
  case " $* " in
    *" --scene "*|*" --scene="*) ;;
    *) argv=("${argv[@]:0:i+1}" --scene "$here/scene.py" "${argv[@]:i+1}") ;;
  esac
fi
exec "$py" -m robosimstudio_real2sim_agent --run-dir "$here/run" "${argv[@]}"

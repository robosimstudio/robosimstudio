#!/usr/bin/env bash
# Runs robosimstudio_real2sim_agent with run/ pinned here, so `up` serves the scene.py beside this script and
# `examples/live/ctl up` from the repository root works as `./ctl up` here. A --run-dir given after this one wins,
# which is how a twin's own ctl (`./ctl new`) pins run/ in its folder. Python: the checkout's .venv, else $PYTHON,
# else python3.
here="$(cd "$(dirname "$0")" && pwd)"; py="$here/../../.venv/bin/python"; [ -x "$py" ] || py="${PYTHON:-python3}"
exec "$py" -m robosimstudio_real2sim_agent --run-dir "$here/run" "$@"
